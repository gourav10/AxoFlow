# AxoFlow Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# NocoDB Configuration
NOCODB_URL=https://anton-server-station.tailfa58fb.ts.net:8081
NOCODB_API_TOKEN=your-api-token-here
NOCODB_BASE_ID=your-base-id-here
NOCODB_TABLE_ID=your-table-id-here

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
